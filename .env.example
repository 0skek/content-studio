# Copy to .env and fill in. Never commit .env.
# Each provider needs just ONE key, used for both text and images.

# Gemini (the default providers, gemini / gemini): from aistudio.google.com/apikey.
# Images need billing on the key's Google project; text works on the free tier. The old name GEMINI_TEXT_API_KEY still works.
GEMINI_API_KEY=

# OpenAI (TEXT_PROVIDER=openai and IMAGE_PROVIDER=openai): from platform.openai.com/api-keys, with prepaid API credit.
# A ChatGPT subscription does not include API access.
OPENAI_API_KEY=

# Cloudflare Workers AI images (IMAGE_PROVIDER=cloudflare only).
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Provider choice. Leave both unset for the production default (gemini / gemini).
# TEXT_PROVIDER=openai
# IMAGE_PROVIDER=openai
# For free, offline local development (no key at all): TEXT_PROVIDER=ollama and IMAGE_PROVIDER=local, then restart the backend.
# Optional overrides:
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_TEXT_FALLBACK_MODELS=[]
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# GEMINI_IMAGE_FALLBACK_MODELS=[]
# OPENAI_IMAGE_QUALITY=medium
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_MAX_OUTPUT_TOKENS=1536
# LOCAL_IMAGE_URL=http://127.0.0.1:8100
