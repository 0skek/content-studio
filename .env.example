# Copy to .env and fill in. Never commit .env.
# Gemini, free tier (no billing), from https://aistudio.google.com/apikey. Used for captions, headlines and reports.
GEMINI_TEXT_API_KEY=
# Cloudflare Workers AI, used for image generation (flux-2-klein-4b).
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Generation providers. The defaults (gemini / cloudflare) are production: use them for the demo.
# For local development without spending quota, uncomment both lines and restart the backend.
# TEXT_PROVIDER=ollama
# IMAGE_PROVIDER=local
# Optional overrides for the local providers:
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_MAX_OUTPUT_TOKENS=1536
# LOCAL_IMAGE_URL=http://127.0.0.1:8100
